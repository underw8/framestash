{
  "manifest_version": 3,
  "name": "Framestash",
  "version": "1.0.2",
  "description": "Save profiles, posts, stories and highlights from instagram.com into a local folder, skipping media you already have.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Framestash"
  },
  "side_panel": {
    "default_path": "manager.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "naming.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
