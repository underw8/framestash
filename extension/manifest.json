{
  "manifest_version": 3,
  "name": "igd: Instagram profile downloader",
  "version": "0.1.0",
  "description": "Download an Instagram profile into a local folder, skipping media you already have.",
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["page.js"],
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["naming.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
